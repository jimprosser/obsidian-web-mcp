# Required runtime paths and credentials
VAULT_PATH=/absolute/path/to/ObsidianVault
VAULT_MCP_TOKEN=replace-with-32-byte-random-hex
VAULT_OAUTH_USERNAME=obsidian
VAULT_OAUTH_PASSWORD=replace-with-an-interactive-login-secret

# Pin the public OAuth resource in reverse-proxy deployments
VAULT_MCP_PUBLIC_URL=https://vault-mcp.example.com
VAULT_MCP_ALLOWED_HOSTS=vault-mcp.example.com

# Persistent per-client OAuth lifecycle state. Keep this outside VAULT_PATH.
VAULT_OAUTH_STATE_PATH=~/.local/share/vault-mcp/oauth_state.sqlite3
VAULT_OAUTH_ACCESS_TOKEN_TTL_SECONDS=86400
VAULT_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Legacy plaintext client registry. Read only by the explicit
# `vault-mcp-oauth migrate` command; normal server startup never touches it.
OAUTH_CLIENTS_PATH=~/.local/share/vault-mcp/oauth_clients.json

# Optional static confidential client for client_credentials or browser flow.
VAULT_OAUTH_CLIENT_ID=vault-mcp-client
VAULT_OAUTH_CLIENT_SECRET=
VAULT_OAUTH_REDIRECT_URIS=

# Server bind and MCP mount (defaults are safe for a local tunnel setup).
VAULT_MCP_HOST=127.0.0.1
VAULT_MCP_PORT=8420
VAULT_MCP_PATH=/
VAULT_MCP_FORWARDED_ALLOW_IPS=127.0.0.1

# Audit log of vault mutations. Empty path disables auditing; the log must
# resolve outside VAULT_PATH.
VAULT_AUDIT_LOG_PATH=
VAULT_AUDIT_LOG_INCLUDE_READS=false

# Daily-note tools: folder inside the vault (empty = vault root), filename
# strftime format, and a template prepended to newly created daily notes.
VAULT_DAILY_NOTES_FOLDER=
VAULT_DAILY_NOTES_FORMAT=%Y-%m-%d
VAULT_DAILY_NOTES_TEMPLATE=

# Optional liveness heartbeat for push-style uptime monitors. Empty URL
# disables it (the default); failures are logged, never fatal.
VAULT_MCP_HEARTBEAT_URL=
VAULT_MCP_HEARTBEAT_INTERVAL=60

# Signed uploads. Master switch is VAULT_UPLOAD_URL_SECRET: with it unset the
# upload tool, route, and bearer-exempt path do not exist. Limits cap one
# upload; the staging directory must resolve outside VAULT_PATH.
VAULT_UPLOAD_URL_SECRET=
VAULT_UPLOAD_URL_TTL_SECONDS=900
VAULT_UPLOAD_URL_MAX_TTL_SECONDS=3600
VAULT_UPLOAD_MAX_BYTES=100000000
VAULT_UPLOAD_STAGING_DIR=~/.local/share/vault-mcp/uploads

# Used only by scripts/setup-tunnel.sh to name the Cloudflare tunnel host;
# the server itself does not read this variable.
VAULT_MCP_HOSTNAME=
